# ==============================================================================
# STUDENT FEEDBACK ANALYSIS SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to '.env' and update values with your local settings.
# Never commit your actual '.env' file containing real passwords to version control!
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
# Secret key used for session signing and flash messaging
# In production, generate a secure 64-character token (e.g., using `python -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=dev-secret-key-change-this-in-production-only-for-local-demo

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_actual_mysql_password_here
MYSQL_DATABASE=student_feedback_db
