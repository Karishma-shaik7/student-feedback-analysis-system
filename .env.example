# ==============================================================================
# STUDENT FEEDBACK ANALYSIS SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to '.env' and update values with your local settings.
# Never commit your actual '.env' file containing real passwords to version control!
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
# Secret key used for session signing and flash messaging
# In production, generate a secure 64-character token:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-secret-key-change-this-in-production-only-for-local-demo

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_actual_mysql_password_here
MYSQL_DATABASE=student_feedback_db

# ==============================================================================
# SSL/TLS Settings
# ==============================================================================
# Local development (localhost MySQL): leave MYSQL_SSL_DISABLED=true.
# Aiven / Cloud MySQL (production): set MYSQL_SSL_DISABLED=false and fill in
# the remaining variables with values from your Aiven service credentials page.
# ==============================================================================

# Set to "false" to enable SSL (required for Aiven and most cloud MySQL providers).
MYSQL_SSL_DISABLED=true

# Absolute path to the CA certificate downloaded from your Aiven service page.
# Example (Render): /etc/secrets/ca.pem  or  /app/certs/ca.pem
# Leave blank for local dev.
MYSQL_SSL_CA=

# Optional: absolute paths to client certificate and key (not required by Aiven by default).
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

# Set to "true" to validate the server's certificate against MYSQL_SSL_CA.
# Recommended for production when MYSQL_SSL_CA is provided.
MYSQL_SSL_VERIFY_CERT=false

# Set to "true" to also verify the server hostname matches the certificate CN/SAN.
# More strict — enable only when your cloud provider hostname matches the cert.
MYSQL_SSL_VERIFY_IDENTITY=false
